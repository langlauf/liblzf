/* The number of bytes in a int.  */
#undef SIZEOF_INT

/* The number of bytes in a long.  */
#undef SIZEOF_LONG

/* The number of bytes in a short.  */
#undef SIZEOF_SHORT

#if SIZEOF_SHORT == 2
  typedef unsigned short u16;
#elif SIZEOF_INT == 4
  typedef unsigned int u16;
#else
  error need 16 bit datatype
#endif

